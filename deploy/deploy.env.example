# Household defaults baked into dist/setup-exchange.sh by installer/build.sh.
# Copy to deploy/deploy.env (git-ignored) and fill in your own values.
# They only matter on a FIRST install; after that /etc/conf.d/exchange on the container is the source of truth.
# Values may not contain a double quote, backtick, dollar sign or backslash.

# Page title and home-screen name. Keep it neutral: never a person's name.
APP_NAME=Gift Exchange

# Port gunicorn listens on, on 127.0.0.1 only. An existing install keeps the port in its config.
# EXCHANGE_PORT=8770

# Not here on purpose: ADMIN_PASSWORD_HASH (it holds dollar signs and is a secret: make it with
# `python3 manage.py hash-password` and put it in /etc/conf.d/exchange) and SECRET_KEY (the app creates
# /var/lib/exchange/secret.key itself).
