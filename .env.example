# Development settings for `python3 app.py`; see the top of settings.py. Copy to .env and export it yourself
# (nothing loads this file). On the server the installer writes /etc/conf.d/exchange instead.
# DATA_DIR and SECRET_KEY are left out: the data folder defaults to ./data, and the app creates DATA_DIR/secret.key.
EXCHANGE_PORT=8770
APP_NAME=Gift Exchange
# Made with: echo 'a-password' | python3 manage.py hash-password   (put it in single quotes: it contains $)
ADMIN_PASSWORD_HASH=
